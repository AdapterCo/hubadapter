// This is your Prisma schema file
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id        String   @id @default(cuid())
  idmaq     String   @unique
  claimed   Boolean  @default(false)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Client {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  passwordHash     String
  mpAccessToken    String?
  mpWebhookSecret  String?
  mpTokenValid     Boolean?
  mpTokenCheckedAt DateTime?
  webhookToken     String         @unique @default(cuid())
  role             String         @default("CLIENT")
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  devices          Device[]
  machines         Machine[]
  payments         Payment[]
  webhookIssues    WebhookIssue[]
}

model Machine {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  location  String?
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  esps      Esp32[]
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Esp32 {
  id               String           @id @default(cuid())
  machineId        String
  serialNumber     String           @unique
  mqttTopic        String           @unique
  online           Boolean          @default(false)
  lastSeen         DateTime?
  lastAckPaymentId String?
  lastAckAt        DateTime?
  credits          Decimal          @default(0) @db.Decimal(12, 2)
  mpPosId          String?
  mpPosName        String?
  machine          Machine          @relation(fields: [machineId], references: [id], onDelete: Cascade)
  payments         Payment[]
  events           TelemetryEvent[]
  createdAt        DateTime         @default(now())

  @@index([machineId])
  @@index([mpPosId])
  @@index([lastSeen])
}

model Payment {
  id          String   @id @default(cuid())
  clientId    String
  esp32Id     String
  mpPaymentId String   @unique
  amount      Decimal  @db.Decimal(12, 2)
  status      String
  externalRef String?
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  esp32       Esp32    @relation(fields: [esp32Id], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([clientId, status, createdAt])
  @@index([esp32Id, createdAt])
}

model TelemetryEvent {
  id        String   @id @default(cuid())
  esp32Id   String
  type      String
  payload   String
  esp32     Esp32    @relation(fields: [esp32Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([esp32Id, createdAt])
  @@index([createdAt])
}

model OutboxMessage {
  id          String    @id @default(cuid())
  paymentId   String    @unique
  esp32Id     String
  topic       String
  payload     String
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  nextAttempt DateTime  @default(now())
  lastError   String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@index([status, nextAttempt])
}

model WebhookIssue {
  id                String   @id @default(cuid())
  clientId          String
  paymentId         String
  reason            String
  posId             String?
  externalReference String?
  resolved          Boolean  @default(false)
  createdAt         DateTime @default(now())
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([resolved, createdAt])
  @@index([clientId, createdAt])
}
